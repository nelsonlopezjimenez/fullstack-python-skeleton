# Copy this file to .env and adjust the values:  copy .env.example .env   (Git Bash: cp)
# .env is git-ignored; .env.example is committed so everyone knows which variables exist.
# Same variables as Chapter 3's server/.env.example, except the token lifetime is in seconds.
#
# Port 8000 (uvicorn's default), so this app can run next to the Node chapters on 3000/5173.
PORT=8000
# Own database name so this app does not share data with the Node version (mernskeleton).
# ?directConnection=true: talk only to this host (needed for the local replica set "mongodb").
MONGODB_URI=mongodb://localhost:27017/pythonskeleton?directConnection=true
# At least 32 characters (PyJWT warns about shorter HS256 secrets). Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
# Token AND cookie lifetime in seconds (86400 = 1 day)
JWT_EXPIRES_IN_SECONDS=86400
# Only when a browser page on another origin calls /api (comma-separated). Usually empty.
# CORS_ORIGIN=http://localhost:5173
# development | production   (production requires a real JWT_SECRET and sends cookies with Secure)
ENV=development
